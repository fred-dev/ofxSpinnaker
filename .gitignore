# Generated SDK assets (sync script will recreate)
libs/spinnaker/include/
libs/spinnaker/lib/

# Example project: only the source under example/src/ is tracked. Everything
# else here is Project Generator scaffolding, regenerated on demand rather
# than committed - bin/, obj/, and *.code-workspace are already excluded by
# the generic patterns below; these are the rest of it.
example/Makefile
example/config.make
example/addons.make
example/.vscode/
examples/

# Build artifacts (platform-agnostic)
bin/
obj/
*.o
*.obj
*.d
*.pdb
*.ilk

# macOS bundle leftovers
*.dSYM
*.app

# Windows build outputs
*.dll
*.lib
*.exe
*.exp
*.sln
*.vcxproj*

# Linux shared objects
*.so*
*.a

# Misc editor files
*.code-workspace
.DS_Store
Thumbs.db

# Large docs fetched locally
Spinnaker-C-Plus-Plus-Programmer-Guide.pdf
